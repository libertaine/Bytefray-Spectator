# Godot
.godot/
*.import
# The arcade cue WAVs are read and SHA-256 verified as raw bytes (scripts/announcer.gd),
# so they use Godot's "Keep File" importer to be exported unchanged.
!audio/announcer/*.wav.import
export_presets.cfg
/build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.no-bytecode-cache/
